<Window x:Class="mcpx_template_project.Views.Controls.DualListSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="{Binding Title}" Height="460" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="380" MinWidth="520"
        Background="{DynamicResource App.PageBackground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <!-- 双列表区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：已选项目 -->
            <GroupBox Grid.Column="0" Header="已选项目" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 搜索框 -->
                    <TextBox Grid.Row="0" Margin="0,0,0,4"
                             Text="{Binding SearchLeftText, UpdateSourceTrigger=PropertyChanged}"/>
                    <!-- 全选/全不选 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="全选" Width="50" FontSize="11"
                                   Command="{Binding SelectAllLeftCommand}" Margin="0,0,4,0"/>
                        <Button Content="全不选" Width="55" FontSize="11"
                                   Command="{Binding DeselectAllLeftCommand}"/>
                    </StackPanel>
                    <!-- 列表 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredSelectedItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayText}"
                                              Margin="2,1" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <!-- 中间箭头按钮 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                <Button Content="←" Width="40" Height="40" FontSize="16"
                           Command="{Binding MoveToSelectedCommand}" Margin="0,0,0,8"
                           ToolTip="将右侧勾选项添加到已选"/>
                <Button Content="→" Width="40" Height="40" FontSize="16"
                           Command="{Binding MoveToAvailableCommand}"
                           ToolTip="将左侧勾选项从已选移除"/>
            </StackPanel>

            <!-- 右侧：可选项目 -->
            <GroupBox Grid.Column="2" Header="可选项目" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 搜索框 -->
                    <TextBox Grid.Row="0" Margin="0,0,0,4"
                             Text="{Binding SearchRightText, UpdateSourceTrigger=PropertyChanged}"/>
                    <!-- 全选/全不选 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="全选" Width="50" FontSize="11"
                                   Command="{Binding SelectAllRightCommand}" Margin="0,0,4,0"/>
                        <Button Content="全不选" Width="55" FontSize="11"
                                   Command="{Binding DeselectAllRightCommand}"/>
                    </StackPanel>
                    <!-- 列表 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredAvailableItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayText}"
                                              Margin="2,1" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="80" Margin="0,0,10,0"
                       Command="{Binding ConfirmCommand}"/>
            <Button Content="取消" Width="80"
                       Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>