<UserControl x:Class="mcpx_template_project.Views.Controls.ActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:mcpx_template_project.Views.Controls"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="800">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4,0,0">
        <Button Content="新增" Width="80" Margin="0,0,8,0"
                   Command="{Binding AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <Button Content="删除" Width="80" Margin="0,0,8,0"
                   Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <Button Content="导入" Width="80" Margin="0,0,8,0"
                   Command="{Binding ImportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <Button Content="导出" Width="80" Margin="0,0,0,0"
                   Command="{Binding ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </StackPanel>
</UserControl>