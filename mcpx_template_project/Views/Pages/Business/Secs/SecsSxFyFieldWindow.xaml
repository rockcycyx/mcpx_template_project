<Window x:Class="mcpx_template_project.Views.Pages.Business.Secs.SecsSxFyFieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SxFy 权限"
        Height="380" Width="520"
        MinHeight="360" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource App.PageBackground}"
        FontSize="13"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SxF（下拉选择，来自已打 [SecsPermission] 注解的路由） -->
        <Grid Grid.Row="0" Margin="20,18,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="SxF 消息"/>
            <ComboBox Grid.Column="1" Height="30"
                      ItemsSource="{Binding Options}"
                      SelectedItem="{Binding SelectedOption}"
                      DisplayMemberPath="SxF"
                      IsEnabled="{Binding CanEditSxF}"/>
        </Grid>

        <!-- 名称 + 状态（同排） -->
        <Grid Grid.Row="1" Margin="20,14,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="名称"/>
            <TextBox Grid.Column="1" VerticalContentAlignment="Center" Padding="6,3" Margin="0,0,16,0"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="状态"/>
            <ComboBox Grid.Column="3" Height="30"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding Status}">
                <ComboBoxItem Content="启用" Tag="0"/>
                <ComboBoxItem Content="停用" Tag="1"/>
            </ComboBox>
        </Grid>

        <!-- 各状态是否允许执行 -->
        <Border Grid.Row="2" Margin="20,16,20,0" Padding="14,12"
                BorderBrush="{DynamicResource App.Divider}" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="允许执行的控制状态" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextSecondary}" Margin="0,0,0,12"
                           HorizontalAlignment="Center"/>
                <CheckBox Content="OffLine（设备离线）" IsChecked="{Binding AllowOffline}" Margin="0,0,0,10"
                          HorizontalAlignment="Center"/>
                <CheckBox Content="OnLine Local（在线-本地）" IsChecked="{Binding AllowOnlineLocal}" Margin="0,0,0,10"
                          HorizontalAlignment="Center"/>
                <CheckBox Content="OnLine Remote（在线-远程）" IsChecked="{Binding AllowOnlineRemote}"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,20,16">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource App.Danger}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="确定" Width="88" Margin="0,0,10,0"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ConfirmBtn_Click"/>
            <Button Content="取消" Width="88" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
