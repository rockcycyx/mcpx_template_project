<Window x:Class="mcpx_template_project.Views.Pages.Business.Secs.SecsVidFieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Business.Secs"
        mc:Ignorable="d"
        Title="VID"
        Height="540" Width="520"
        MinHeight="440" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource App.PageBackground}"
        FontSize="13"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,18"
                Background="Transparent"
                BorderBrush="{DynamicResource App.Divider}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="变量类型"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,12"
                          ItemsSource="{Binding TypeOptions}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding VidType}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="VID 编号"/>
                <TextBox Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" Padding="6,3" Margin="0,0,0,12"
                         Text="{Binding VidIdText, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="名称"/>
                <TextBox Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" Padding="6,3" Margin="0,0,0,12"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="数据类型"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Height="30" Margin="0,0,0,12"
                          ItemsSource="{Binding DataTypeOptions}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding DataType}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="值来源"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Height="30" Margin="0,0,0,12"
                          ItemsSource="{Binding SourceOptions}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Source}"/>

                <!-- 从 [PlcRead] 注解字段选择（DB 来源时隐藏，选字段会自动切到 plc 来源） -->
                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="注解字段"
                           Visibility="{Binding IsPlcSource, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ComboBox Grid.Row="5" Grid.Column="1" Height="30" Margin="0,0,0,12"
                          ItemsSource="{Binding FieldOptions}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Index"
                          SelectedValue="{Binding SelectedFieldIndex}"
                          Visibility="{Binding IsPlcSource, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="设备代号"
                           Visibility="{Binding IsPlcSource, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBox Grid.Row="6" Grid.Column="1" VerticalContentAlignment="Center" Padding="6,3" Margin="0,0,0,12"
                         Text="{Binding DeviceCode, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsPlcSource, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="点位地址"
                           Visibility="{Binding IsPlcSource, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBox Grid.Row="7" Grid.Column="1" VerticalContentAlignment="Center" Padding="6,3" Margin="0,0,0,12"
                         Text="{Binding PlcAddress, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsPlcSource, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="固定值"/>
                <TextBox Grid.Row="8" Grid.Column="1" VerticalContentAlignment="Center" Padding="6,3" Margin="0,0,0,12"
                         Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="值来源为 DB 时生效：该 VID 的值直接取此固定值"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="状态"/>
                <ComboBox Grid.Row="9" Grid.Column="1" Height="30" Margin="0,0,0,0"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding Status}">
                    <ComboBoxItem Content="启用" Tag="0"/>
                    <ComboBoxItem Content="停用" Tag="1"/>
                </ComboBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource App.Danger}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="确定" Width="88" Margin="0,0,10,0"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ConfirmBtn_Click"/>
            <Button Content="取消" Width="88" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
