<Window x:Class="mcpx_template_project.Views.Pages.Business.SecsGem.SecsGemSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SECS/GEM 设定"
        Height="560" Width="860"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource App.PageBackground}"
        FontSize="13">

    <Window.Resources>
        <!-- 状态胶囊：可点击切换，启用=绿色，停用=灰色 -->
        <Style x:Key="StatusPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#20000000"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="12" Padding="12,2"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="0">
                    <Setter Property="Background" Value="#1400C853"/>
                    <Setter Property="Foreground" Value="{DynamicResource App.Success}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== 左侧：实例列表 ===================== -->
        <Border Grid.Column="0" Padding="12"
                Background="{DynamicResource App.CardBackground}" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="SECS 实例" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextSecondary}" Margin="2,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="新增" Width="64" Margin="0,0,6,0"
                            Command="{Binding NewCommand}"/>
                    <Button Content="删除" Width="64" Margin="0,0,6,0"
                            Command="{Binding DeleteCommand}"/>
                    <Button Content="刷新" Width="64"
                            Command="{Binding RefreshInstancesCommand}"/>
                </StackPanel>

                <ListView Grid.Row="2"
                          ItemsSource="{Binding Instances}"
                          SelectedItem="{Binding SelectedInstance}"
                          DisplayMemberPath="Name"
                          SelectionMode="Single"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Background="Transparent" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- 分隔线 -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent"
                      ShowsPreview="True"/>

        <!-- ===================== 右侧：编辑区 ===================== -->
        <ScrollViewer Grid.Column="2" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 通讯参数 -->
                <Border Padding="18,16"
                        Background="Transparent"
                        BorderBrush="{DynamicResource App.Divider}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 名称 | 状态 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="实例名称" VerticalAlignment="Center" Margin="0,0,10,14"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,14"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="状态" VerticalAlignment="Center" Margin="20,0,10,14"/>
                        <Button Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" Margin="0,0,0,14"
                                Style="{StaticResource StatusPillButtonStyle}"
                                Command="{Binding ToggleStatusCommand}">
                            <Button.Content>
                                <TextBlock Text="{Binding StatusText}"/>
                            </Button.Content>
                        </Button>

                        <!-- IP | Port -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="IP 地址" VerticalAlignment="Center" Margin="0,0,10,14"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,14"
                                 Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="本机监听 IP（Passive 端绑定地址，0.0.0.0 表示所有网卡）"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="端口" VerticalAlignment="Center" Margin="20,0,10,14"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,14"
                                 Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEdit}"
                                 ToolTip="1 ~ 65535（监听中不可修改）"/>

                        <!-- DeviceID | 模式 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="DeviceID" VerticalAlignment="Center" Margin="0,0,10,14"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,14"
                                 Text="{Binding DeviceIdText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="设备 ID（Equipment 端通常为 0）"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="启动模式" VerticalAlignment="Center" Margin="20,0,10,14"/>
                        <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,0,0,14"
                                  SelectedValuePath="Tag" SelectedValue="{Binding ConnectMode}">
                            <ComboBoxItem Content="手动" Tag="manual"/>
                            <ComboBoxItem Content="自动" Tag="auto"/>
                        </ComboBox>

                        <!-- PLC 通讯设定 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="PLC 通讯设定" VerticalAlignment="Center" Margin="0,0,10,14"
                                   ToolTip="关联的 comm_setting，可空（纯上报实例不依赖 PLC）"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,14"
                                  ItemsSource="{Binding CommSettings}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedCommSetting}"/>

                        <!-- 连接状态 -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="连接状态" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource App.TextTertiary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource App.Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StateText}" VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.TextPrimary}"/>
                            <TextBlock Text="对端 Host：" VerticalAlignment="Center" Margin="20,0,0,0"
                                       Foreground="{DynamicResource App.TextSecondary}"/>
                            <TextBlock Text="{Binding DeviceIp}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextSecondary}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 超时参数 -->
                <Border Padding="18,16" Margin="0,12,0,0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource App.Divider}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="超时参数（ms）" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextSecondary}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="T3 回复超时" VerticalAlignment="Center" Margin="0,0,10,10"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                                     Text="{Binding T3Text, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="T5 连接建立" VerticalAlignment="Center" Margin="20,0,10,10"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,10"
                                     Text="{Binding T5Text, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="T6 控制消息" VerticalAlignment="Center" Margin="0,0,10,10"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                     Text="{Binding T6Text, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="T7 选择状态" VerticalAlignment="Center" Margin="20,0,10,10"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,10"
                                     Text="{Binding T7Text, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="T8 分片接收" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding T8Text, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 错误提示 -->
                <TextBlock Margin="4,10,4,0"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource App.Danger}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- 底部操作栏 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="保存" Width="88" Margin="0,0,10,0"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{Binding CanEdit}"
                            Command="{Binding SaveCommand}"/>
                    <Button Width="110" Command="{Binding ToggleRunCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="启动监听"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Content" Value="停止监听"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="ToolTip" Value="该实例已停用，无法启用监听"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
