<Page x:Class="mcpx_template_project.Views.Pages.Business.Trigger.PageTrigger"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:ctrl="clr-namespace:mcpx_template_project.Views.Controls"
        xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Business.Trigger"
        mc:Ignorable="d"
        Title="触发器 IO 设定"
        Background="{DynamicResource App.PageBackground}"
        FontSize="13">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="14,12"
                Background="{DynamicResource App.CardBackground}" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 查询栏：自动换行布局 -->
                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                        <TextBlock Text="触发名" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource App.TextSecondary}"/>
                        <TextBox Width="150" VerticalContentAlignment="Center"
                                 Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                        <TextBlock Text="通讯设定" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource App.TextSecondary}"/>
                        <ComboBox Width="140" Height="30"
                                  ItemsSource="{Binding SettingOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding FilterCommSettingId}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                        <TextBlock Text="设备代号" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource App.TextSecondary}"/>
                        <ComboBox Width="130" Height="30"
                                  ItemsSource="{Binding DeviceCodeOptions}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding FilterDeviceCode}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                        <TextBlock Text="点位" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource App.TextSecondary}"/>
                        <TextBox Width="100" VerticalContentAlignment="Center"
                                 Text="{Binding FilterAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                        <TextBlock Text="类型" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource App.TextSecondary}"/>
                        <ComboBox Width="90" Height="30"
                                  ItemsSource="{Binding TriggerTypeOptions}"
                                  DisplayMemberPath="Value"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding FilterTriggerType}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                        <TextBlock Text="触发方式" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource App.TextSecondary}"/>
                        <ComboBox Width="120" Height="30"
                                  ItemsSource="{Binding TriggerModeOptions}"
                                  DisplayMemberPath="Value"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding FilterTriggerMode}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                        <TextBlock Text="事件处理器" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource App.TextSecondary}"/>
                        <ComboBox Width="140" Height="30"
                                  ItemsSource="{Binding HandlerOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding FilterActionKey}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                        <TextBlock Text="警报类别" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource App.TextSecondary}"/>
                        <ComboBox Width="140" Height="30"
                                  ItemsSource="{Binding CategoryOptions}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding FilterAlarmCategory}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <Button Content="搜索" Width="72" Margin="0,0,8,0"
                                Command="{Binding LoadCommand}"/>
                        <Button Content="重置" Width="72"
                                Command="{Binding ResetFilterCommand}"/>
                    </StackPanel>
                </WrapPanel>

                <!-- 查询栏第二行：新增/导入/导出按钮 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="新增" Width="80" Margin="0,0,8,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding AddTriggerCommand}"/>
                    <Button Content="导入" Width="72" Margin="0,0,8,0"
                            Command="{Binding ImportTriggerCommand}"/>
                    <Button Content="导出" Width="72" Margin="0,0,8,0"
                            Command="{Binding ExportTriggerCommand}"/>
                    <Button Content="导出模板" Width="88"
                            Command="{Binding ExportTemplateCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 触发器列表 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Triggers}"
                  SelectedItem="{Binding SelectedTrigger}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeaderWidth="0"
                  Background="Transparent"
                  BorderThickness="0"
                  ColumnHeaderStyle="{StaticResource FluentDataGridColumnHeader}"
                  RowStyle="{StaticResource FluentDataGridRow}"
                  CellStyle="{StaticResource FluentDataGridCell}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="通讯设定" Binding="{Binding CommSettingName}" Width="120" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="点位" Binding="{Binding FullAddress}" Width="100" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="类型" Width="90" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    CornerRadius="12" Padding="12,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource App.CardBorder}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TriggerType}" Value="alarm">
                                                <Setter Property="Background" Value="#33E5484D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="事件"/>
                                            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TriggerType}" Value="alarm">
                                                    <Setter Property="Text" Value="警报"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="触发方式" Width="90" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="值变化"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TriggerMode}" Value="on">
                                                <Setter Property="Text" Value="ON"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="事件处理器" Binding="{Binding ActionKey}" Width="120" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="警报类别" Width="150" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ComboBox MinWidth="130" Height="30"
                                          ItemsSource="{Binding DataContext.CategoryOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding AlarmCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding IsAlarm, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          SelectionChanged="AlarmCategoryCombo_SelectionChanged"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="状态" Width="110" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:ToggleSwitch MinWidth="0" Padding="0"
                                                 OnContent="启用" OffContent="停用"
                                                 IsOn="{Binding Status, Mode=OneWay, Converter={StaticResource TriggerStatusToBoolConverter}}"
                                                 ctrl:ToggleSwitchCommandBehavior.Command="{Binding DataContext.SwitchStatusCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                 ctrl:ToggleSwitchCommandBehavior.CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="触发名/警报名" Binding="{Binding Name}" Width="*" MinWidth="150" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="操作" Width="120" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="编辑" Width="60" Margin="0,0,6,0"
                                        Command="{Binding DataContext.EditTriggerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="删除" Width="60"
                                        Command="{Binding DataContext.DeleteTriggerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部统计 -->
        <TextBlock Grid.Row="2" Margin="2,6,0,0" FontSize="12"
                   Foreground="{DynamicResource App.TextSecondary}"
                   Text="{Binding Summary}"/>
    </Grid>
</Page>
