<Window x:Class="mcpx_template_project.Views.Pages.Business.Trigger.TriggerFieldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Business.Trigger"
        mc:Ignorable="d"
        Title="触发器"
        Height="540" Width="560"
        MinHeight="440" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource App.PageBackground}"
        FontSize="13"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,18"
                Background="Transparent"
                BorderBrush="{DynamicResource App.Divider}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="设备(通讯设定)"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,12"
                          ItemsSource="{Binding SettingOptions}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding CommSettingId}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="类型(设备代号)"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,12"
                          ItemsSource="{Binding DeviceCodeOptions}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding DeviceCode}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="点位(地址)"/>
                <TextBox Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" Padding="6,3" Margin="0,0,0,12"
                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="触发器类型"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Height="30" Margin="0,0,0,12"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding TriggerType}">
                    <ComboBoxItem Content="警报" Tag="alarm"/>
                    <ComboBoxItem Content="事件" Tag="event"/>
                </ComboBox>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="触发方式"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Height="30" Margin="0,0,0,12"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding TriggerMode}">
                    <ComboBoxItem Content="上升沿" Tag="on"/>
                    <ComboBoxItem Content="值变化" Tag="change"/>
                </ComboBox>

                <!-- 事件处理器（仅事件类型显示） -->
                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="事件处理器"
                           Visibility="{Binding IsEvent, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ComboBox Grid.Row="5" Grid.Column="1" Height="30" Margin="0,0,0,12"
                          ItemsSource="{Binding HandlerOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding ActionKey}"
                          Visibility="{Binding IsEvent, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- 警报专属：警报类别 + 是否上报 SECS（仅警报类型显示，并排） -->
                <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12"
                      Visibility="{Binding IsAlarm, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="警报类别"/>
                    <ComboBox Grid.Column="1" Height="30" Margin="0,0,10,0"
                              ItemsSource="{Binding CategoryOptions}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding AlarmCategory}"/>

                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="是否上报 SECS"/>
                    <ComboBox Grid.Column="3" Height="30"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding ReportAlarm}">
                        <ComboBoxItem Content="上报" Tag="1"/>
                        <ComboBoxItem Content="不上报" Tag="0"/>
                    </ComboBox>
                </Grid>

                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="触发名/警报名"/>
                <TextBox Grid.Row="7" Grid.Column="1" VerticalContentAlignment="Center" Padding="6,3" Margin="0,0,0,12"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="状态(是否监控)"/>
                <ComboBox Grid.Row="8" Grid.Column="1" Height="30" Margin="0,0,0,0"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding Status}">
                    <ComboBoxItem Content="启用" Tag="1"/>
                    <ComboBoxItem Content="停用" Tag="0"/>
                </ComboBox>

                <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Remark"/>
                <TextBox Grid.Row="9" Grid.Column="1" VerticalContentAlignment="Center" Padding="6,3" Margin="0,0,0,0"
                         Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource App.Danger}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="确定" Width="88" Margin="0,0,10,0"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ConfirmBtn_Click"/>
            <Button Content="取消" Width="88" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
