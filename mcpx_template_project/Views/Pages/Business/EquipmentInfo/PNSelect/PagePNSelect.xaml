<Page x:Class="mcpx_template_project.Views.Pages.Business.EquipmentInfo.PNSelect.PagePNSelect"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Business.EquipmentInfo.PNSelect"
      mc:Ignorable="d"
      Title="PNSelect"
      Background="{DynamicResource App.PageBackground}"
      FontSize="13">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏：配方名称搜索 + 写入目标 PLC 单选 + 新增 -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="14,12"
                Background="{DynamicResource App.CardBackground}" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="配方名称" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource App.TextSecondary}"/>
                    <TextBox Width="180" VerticalContentAlignment="Center"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="搜索" Width="64" Margin="8,0,0,0" Command="{Binding LoadCommand}"/>
                </StackPanel>

                <!-- 写入目标 PLC 单选框（放配方名称右侧） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="写入目标 PLC" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource App.TextSecondary}"/>
                    <ComboBox Width="220" Height="30" VerticalContentAlignment="Center"
                              ItemsSource="{Binding ConnectedSettings}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedSetting}"/>
                    <Button Content="刷新连接" Width="84" Margin="8,0,0,0"
                            Command="{Binding RefreshConnectionsCommand}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="新增配方" Width="120"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding AddRecipeCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容：左列表 + 右读回 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：配方列表（含编辑/删除） -->
            <Border Grid.Column="0" Padding="10"
                    Background="{DynamicResource App.CardBackground}" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Recipes}"
                              SelectedItem="{Binding SelectedRecipe}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeaderWidth="0"
                              Background="Transparent"
                              BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource FluentDataGridColumnHeader}"
                              RowStyle="{StaticResource FluentDataGridRow}"
                              CellStyle="{StaticResource FluentDataGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="配方名称" Binding="{Binding RecipeName}" Width="*" MinWidth="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="操作" Width="118" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="编辑" Width="44" Height="24" Padding="0"
                                                    Command="{Binding DataContext.EditRecipeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="删除" Width="44" Height="24" Padding="0" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteRecipeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1" Margin="2,6,0,0" FontSize="12"
                               Foreground="{DynamicResource App.TextSecondary}"
                               Text="{Binding Summary}"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <!-- 右侧：写入 + 读 PLC 实际值 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,0,0,0">

                    <!-- 写入操作 -->
                    <Border Padding="16,14" Background="{DynamicResource App.CardBackground}" CornerRadius="8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource App.TextTertiary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WriteSuccessFlag}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource App.Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding WriteSuccessFlag}" Value="False">
                                                        <Setter Property="Fill" Value="{DynamicResource App.Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.TextPrimary}"
                                               Text="{Binding WriteSuccessText}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="使用当前目标配方" Width="165" Height="36"
                                        Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{Binding CanWrite}"
                                        Command="{Binding WriteToPlcCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 读 PLC 实际值 -->
                    <Border Padding="16,14" Margin="0,12,0,0" Background="{DynamicResource App.CardBackground}" CornerRadius="8">
                        <DataGrid ItemsSource="{Binding Readbacks}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  RowHeaderWidth="0"
                                  RowHeight="34"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource FluentDataGridColumnHeader}"
                                  RowStyle="{StaticResource FluentDataGridRow}"
                                  CellStyle="{StaticResource FluentDataGridCell}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="配方参数" Binding="{Binding DisplayName}" Width="*" MinWidth="120" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="目标值" Binding="{Binding TargetValue}" Width="120" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="120" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
