<Window x:Class="mcpx_template_project.Views.Pages.Business.EquipmentInfo.PNSelect.RecipeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Business.EquipmentInfo.PNSelect"
        mc:Ignorable="d"
        Title="配方"
        Height="640" Width="520"
        MinHeight="560" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource App.PageBackground}"
        FontSize="13"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,18"
                Background="Transparent"
                BorderBrush="{DynamicResource App.Divider}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="配方名称"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="膜宽"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,0,10"
                              ItemsSource="{Binding MembraneWidthOptions}"
                              DisplayMemberPath="Display" SelectedValuePath="Value"
                              SelectedValue="{Binding MembraneWidth, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="一段上热压轮温度"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding UpperLamiTmpStage1, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="一段下热压轮温度"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding LowerLamiTmpStage1, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="二段上热压轮温度"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding UpperLamiTmpStage2, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="二段下热压轮温度"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding LowerLamiTmpStage2, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="出板温度"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding PanelOutTmp, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="上贴膜温度"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding UpperTackingTmp, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="下贴膜温度"/>
                    <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding LowerTackingTmp, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="输送速度"/>
                    <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding DrvSpeed, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="上贴膜压力"/>
                    <TextBox Grid.Row="10" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding UpperTackingPressure, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="前留铜"/>
                    <TextBox Grid.Row="11" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding FrontCuPos, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="后留铜"/>
                    <TextBox Grid.Row="12" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding RearCuPos, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="13" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="一段压轮压力"/>
                    <TextBox Grid.Row="13" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding RollerPressureStage1, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="14" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="二段压轮压力"/>
                    <TextBox Grid.Row="14" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding RollerPressureStage2, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="15" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="贴膜时间"/>
                    <TextBox Grid.Row="15" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,10"
                             Text="{Binding DurationFilm, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

                    <TextBlock Grid.Row="16" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="板厚"/>
                    <TextBox Grid.Row="16" Grid.Column="1" Style="{StaticResource FieldBox}" Margin="0,0,0,0"
                             Text="{Binding PlateThickness, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource App.Danger}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Content="确定" Width="88" Margin="0,0,10,0"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ConfirmBtn_Click"/>
            <Button Content="取消" Width="88" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
