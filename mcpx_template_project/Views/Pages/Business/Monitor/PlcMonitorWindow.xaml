<Window x:Class="mcpx_template_project.Views.Pages.Business.Monitor.PlcMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="实时监控"
        Height="640" Width="1080"
        MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.PageBackground}"
        FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="14,12"
                Background="{DynamicResource App.CardBackground}" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行：监控控制 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 启动/停止监控 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="100" Height="32"
                                Command="{Binding StartMonitorCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                    <Setter Property="Content" Value="启动监控"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Width="100" Height="32" Margin="8,0,0,0"
                                Command="{Binding StopMonitorCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="停止监控"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- 刷新周期 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="刷新周期(ms)" VerticalAlignment="Center"
                                   Foreground="{DynamicResource App.TextSecondary}"/>
                        <TextBox Width="80" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                 Text="{Binding RefreshIntervalMs, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- 手动刷新 -->
                    <Button Grid.Column="2" Content="手动刷新" Width="80" Height="32" Margin="16,0,0,0"
                            Command="{Binding RefreshCommand}"/>

                    <!-- 状态指示 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource App.TextTertiary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource App.Success}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="未监控"/>
                                    <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                            <Setter Property="Text" Value="监控中"/>
                                            <Setter Property="Foreground" Value="{DynamicResource App.Success}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- 第二行：查询筛选 -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="通讯设定" VerticalAlignment="Center"
                               Foreground="{DynamicResource App.TextSecondary}"/>
                    <TextBox Grid.Column="1" Margin="8,0,0,0" Height="30" VerticalContentAlignment="Center"
                             Text="{Binding FilterSettingName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="2" Text="区域" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{DynamicResource App.TextSecondary}"/>
                    <ComboBox Grid.Column="3" Margin="8,0,0,0" Height="30" VerticalContentAlignment="Center"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding FilterAreaType, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="全部"/>
                        <ComboBoxItem Content="AI"/>
                        <ComboBoxItem Content="AO"/>
                        <ComboBoxItem Content="DI"/>
                        <ComboBoxItem Content="DO"/>
                    </ComboBox>

                    <TextBlock Grid.Column="4" Text="设备代号" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{DynamicResource App.TextSecondary}"/>
                    <TextBox Grid.Column="5" Margin="8,0,0,0" Height="30" VerticalContentAlignment="Center"
                             Text="{Binding FilterDeviceCode, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="6" Text="PLC地址" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{DynamicResource App.TextSecondary}"/>
                    <TextBox Grid.Column="7" Margin="8,0,0,0" Height="30" VerticalContentAlignment="Center"
                             Text="{Binding FilterPlcAddress, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Grid.Column="8" Content="清空" Width="60" Height="30" Margin="16,0,0,0"
                            Command="{Binding ClearFilterCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 点位数据：左侧单头列表 + 右侧选中单头的子值明细 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：单头列表（通讯设定/区域/设备代号/地址/点数 + 状态/错误） -->
            <Border Grid.Column="0" Padding="0" CornerRadius="8"
                    Background="{DynamicResource App.CardBackground}">
                <DataGrid ItemsSource="{Binding Points}"
                          SelectedItem="{Binding SelectedPoint}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeaderWidth="0"
                          Background="Transparent"
                          BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource FluentDataGridColumnHeader}"
                          RowStyle="{StaticResource FluentDataGridRow}"
                          CellStyle="{StaticResource FluentDataGridCell}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="通讯设定" Binding="{Binding SettingName}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="区域" Binding="{Binding AreaType}" Width="56" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="设备代号" Binding="{Binding DeviceCode}" Width="72" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="地址" Binding="{Binding PlcAddress}" Width="80" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="点数" Binding="{Binding Quantity}" Width="56" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="76" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="状态" Width="72" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource App.TextTertiary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource App.Success}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdateTime, StringFormat=HH:mm:ss.fff}" Width="96" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="*" MinWidth="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource App.Danger}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ShowsPreview="True"/>

            <!-- 右侧：选中单头的子值明细（设备代号+地址 → 值） -->
            <Border Grid.Column="2" Padding="0" CornerRadius="8"
                    Background="{DynamicResource App.CardBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 右侧标题：当前选中单头摘要 -->
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource App.Divider}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="点位值" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.TextSecondary}"/>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPoint}" Value="{x:Null}">
                                                <Setter Property="Text" Value="（请选择左侧区域）"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.TextPrimary}"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedPoint.FullAddress}"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SelectedPoint.Values}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeaderWidth="0"
                              Background="Transparent"
                              BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource FluentDataGridColumnHeader}"
                              RowStyle="{StaticResource FluentDataGridRow}"
                              CellStyle="{StaticResource FluentDataGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="设备代号" Binding="{Binding DeviceCode}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PLC地址" Binding="{Binding PlcAddress}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="值" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 FontWeight="SemiBold"
                                                 Padding="4,2"
                                                 ToolTip="输入新值后按回车或移开焦点写入 PLC">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter"
                                                            Command="{Binding DataContext.WriteSubValueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                            </TextBox.InputBindings>
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                                            <Setter Property="Background" Value="{DynamicResource App.CardBackground}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="写入" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="写入" Width="48" Height="26" Padding="0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Command="{Binding DataContext.WriteSubValueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="14,8"
                Background="{DynamicResource App.CardBackground}" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0"
                           Foreground="{DynamicResource App.TextSecondary}">
                    <Run Text="已连接设定："/>
                    <Run Text="{Binding ConnectedCount}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0"
                           Foreground="{DynamicResource App.TextSecondary}">
                    <Run Text="点位总数："/>
                    <Run Text="{Binding PointCount}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{DynamicResource App.TextSecondary}">
                    <Run Text="在线："/>
                    <Run Text="{Binding OnlineCount}" FontWeight="SemiBold" Foreground="{DynamicResource App.Success}"/>
                </TextBlock>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding LastRefreshTime}"
                           Foreground="{DynamicResource App.TextSecondary}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
