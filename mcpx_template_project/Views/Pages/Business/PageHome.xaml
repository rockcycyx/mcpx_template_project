<Page x:Class="mcpx_template_project.Views.Pages.Business.PageHome"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Business"
        xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Business"
        mc:Ignorable="d"
        Title="首页"
        Background="{DynamicResource App.PageBackground}"
        FontSize="13">

    <Page.Resources>
        <!-- 状态胶囊样式：机台状态/蓝灯/蜂鸣器统一展示 -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 数据项标签 -->
        <Style x:Key="ItemLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 数据项数值 -->
        <Style x:Key="ItemValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource UiBrush.Text}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 分区标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.TextTertiary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="机台监控" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource UiBrush.Text}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="14,3,0,0"
                           Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 机台卡片容器 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Machines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="440" Margin="0,0,14,14" Padding="18,16"
                                Background="{DynamicResource App.CardBackground}"
                                BorderBrush="{DynamicResource App.CardBorder}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 机台名称 + 状态胶囊 -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource UiBrush.Text}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource App.TextTertiary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource App.Success}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource App.TextSecondary}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="未连接"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                <Setter Property="Text" Value="{Binding CommSettingName}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 机台状态胶囊 -->
                                    <Border Grid.Column="1">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                                <Setter Property="Background" Value="{DynamicResource App.CardBorder}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MachineState}" Value="2">
                                                        <Setter Property="Background" Value="{DynamicResource App.AccentSubtle}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MachineState}" Value="1">
                                                        <Setter Property="Background" Value="#33F0A020"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding MachineStateText}" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MachineState}" Value="2">
                                                            <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MachineState}" Value="1">
                                                            <Setter Property="Foreground" Value="{DynamicResource App.Warning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- SECS/GEM 连接状态 -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource App.TextTertiary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SecsCommunicating}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource App.Success}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="SECS/GEM" Style="{StaticResource ItemLabel}" Margin="0,0,8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.TextSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding SecsStateText}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SecsCommunicating}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource App.Success}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.TextTertiary}"
                                                   Text="{Binding SecsInstanceName, StringFormat=({0})}"/>
                                        <!-- 控制状态胶囊（GEM Control State） -->
                                        <Border Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                                    <Setter Property="Background" Value="{DynamicResource App.CardBorder}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SecsControlState}" Value="OnlineRemote">
                                                            <Setter Property="Background" Value="{DynamicResource App.AccentSubtle}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SecsControlState}" Value="OnlineLocal">
                                                            <Setter Property="Background" Value="#33F0A020"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" VerticalAlignment="Center"
                                                       Text="{Binding SecsControlStateText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SecsControlState}" Value="OnlineRemote">
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SecsControlState}" Value="OnlineLocal">
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Warning}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- 料号 / 批号 -->
                                <Grid Grid.Row="2" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource ItemLabel}" Text="料号 ObjectID"/>
                                        <TextBlock Style="{StaticResource ItemValue}" Text="{Binding ObjectId}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource ItemLabel}" Text="批号 LotID"/>
                                        <TextBlock Style="{StaticResource ItemValue}" Text="{Binding LotId}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 批量生产 -->
                                <Border Grid.Row="3" Margin="0,0,0,12" Padding="12,10"
                                        Background="{DynamicResource App.PageBackground}" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource ItemLabel}" Text="批量生产进度"/>
                                            <TextBlock Style="{StaticResource ItemValue}" Text="{Binding BatchProgressText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Style="{StaticResource ItemLabel}" Text="设定数量" HorizontalAlignment="Right"/>
                                            <TextBlock Style="{StaticResource ItemValue}" Text="{Binding TargetBatchCount}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 灯 / 蜂鸣器 + 产量统计 -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左：灯 + 蜂鸣器 -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="信号"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="14" Height="14" CornerRadius="7" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource App.TextTertiary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BlueLamp}" Value="1">
                                                                <Setter Property="Background" Value="#FF00A2FF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding BlueLamp}" Value="2">
                                                                <Setter Property="Background" Value="#FF00A2FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="蓝灯" Style="{StaticResource ItemLabel}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding BlueLampText}" Style="{StaticResource ItemValue}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="蜂鸣器" Style="{StaticResource ItemLabel}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding BuzzerText}" Style="{StaticResource ItemValue}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 右：产量统计 -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="产量统计"/>
                                        <UniformGrid Columns="2" Rows="3">
                                            <StackPanel Margin="0,0,4,6">
                                                <TextBlock Style="{StaticResource ItemLabel}" Text="有效功率"/>
                                                <TextBlock Style="{StaticResource ItemValue}" Text="{Binding EffectivePower, StringFormat={}{0:0.###}}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Style="{StaticResource ItemLabel}" Text="总产量"/>
                                                <TextBlock Style="{StaticResource ItemValue}" Text="{Binding TotalProduction, StringFormat={}{0:0.###}}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,4,6">
                                                <TextBlock Style="{StaticResource ItemLabel}" Text="日产量"/>
                                                <TextBlock Style="{StaticResource ItemValue}" Text="{Binding DailyProduction, StringFormat={}{0:0.###}}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Style="{StaticResource ItemLabel}" Text="切刀次数"/>
                                                <TextBlock Style="{StaticResource ItemValue}" Text="{Binding CutterUseCount}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,4,0">
                                                <TextBlock Style="{StaticResource ItemLabel}" Text="压条次数"/>
                                                <TextBlock Style="{StaticResource ItemValue}" Text="{Binding FilmBarUseCount, StringFormat={}{0:0.###}}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
