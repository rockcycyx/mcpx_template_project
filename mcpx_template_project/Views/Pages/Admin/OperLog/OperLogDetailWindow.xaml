<Window x:Class="mcpx_template_project.Views.Pages.Admin.OperLog.OperLogDetailWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Admin.OperLog"
      xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Admin.OperLog"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      mc:Ignorable="d" 
      Height="600" Width="700"
      WindowStartupLocation="CenterOwner"
      ResizeMode="CanResize"
      Background="{DynamicResource App.PageBackground}"
      Title="操作日志详情">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 操作模块 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="操作模块" VerticalAlignment="Center" Margin="0,0,10,15" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,0,15"/>

        <!-- 登录信息 -->
        <TextBlock Grid.Row="0" Grid.Column="2" Text="登录信息" VerticalAlignment="Center" Margin="20,0,10,15" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="20,0,0,15">
            <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} / {1}">
                    <Binding Path="OperName"/>
                    <Binding Path="OperIp"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

        <!-- 操作方法 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="操作方法" VerticalAlignment="Center" Margin="0,0,10,15" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Method}" VerticalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

        <!-- 请求参数 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="请求参数" VerticalAlignment="Top" Margin="0,0,10,10" FontWeight="SemiBold" Padding="0,5,0,0"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,15"
                 Text="{Binding OperParam}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Height="80"
                 Padding="8"/>

        <!-- 返回参数 -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="返回参数" VerticalAlignment="Top" Margin="0,0,10,10" FontWeight="SemiBold" Padding="0,5,0,0"/>
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,15"
                 Text="{Binding JsonResult}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Height="80"
                 Padding="8"/>

        <!-- 错误消息 -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="错误消息" VerticalAlignment="Top" Margin="0,0,10,10" FontWeight="SemiBold" Padding="0,5,0,0"/>
        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,15"
                 Text="{Binding ErrorMsg}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Height="80"
                 Padding="8"/>

        <!-- 操作状态 -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="操作状态" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0">
            <TextBlock.Text>
                <Binding Path="StatusText"/>
            </TextBlock.Text>
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource App.Success}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="1">
                            <Setter Property="Foreground" Value="{DynamicResource App.Danger}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 消耗时间 -->
        <TextBlock Grid.Row="5" Grid.Column="2" Text="消耗时间" VerticalAlignment="Center" Margin="20,0,10,0" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="5" Grid.Column="3" VerticalAlignment="Center" Margin="20,0,0,0">
            <TextBlock.Text>
                <Binding Path="CostTime" StringFormat="{}{0}毫秒"/>
            </TextBlock.Text>
        </TextBlock>
    </Grid>
</Window>
