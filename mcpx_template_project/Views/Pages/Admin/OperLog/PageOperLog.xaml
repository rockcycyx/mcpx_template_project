<Page x:Class="mcpx_template_project.Views.Pages.Admin.OperLog.PageOperLog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Admin.OperLog"
      xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Admin.OperLog"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ctrl="clr-namespace:mcpx_template_project.Views.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1200"
      Title="操作日志">
    <Border Background="{DynamicResource App.PageBackground}" Margin="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10" Background="{DynamicResource App.CardBackground}" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                            <TextBlock Text="模块标题" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Width="150"
                                     Text="{Binding SearchTitle, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                            <TextBlock Text="操作类型" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox Width="100"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding SearchBusinessType}">
                                <ComboBoxItem Content="全部" Tag="{x:Null}"/>
                                <ComboBoxItem Content="新增" Tag="1"/>
                                <ComboBoxItem Content="修改" Tag="2"/>
                                <ComboBoxItem Content="删除" Tag="3"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                            <TextBlock Text="操作人员" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Width="120"
                                     Text="{Binding SearchOperName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                            <TextBlock Text="操作IP" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Width="120"
                                     Text="{Binding SearchOperIp, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                            <TextBlock Text="状态" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox Width="80"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding SearchStatus}">
                                <ComboBoxItem Content="全部" Tag="{x:Null}"/>
                                <ComboBoxItem Content="正常" Tag="0"/>
                                <ComboBoxItem Content="异常" Tag="1"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                            <TextBlock Text="开始时间" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <DatePicker Width="160"
                                        SelectedDate="{Binding SearchBeginTime}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                            <TextBlock Text="结束时间" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <DatePicker Width="160"
                                        SelectedDate="{Binding SearchEndTime}"/>
                        </StackPanel>

                        <Button Content="搜索" Width="80" Margin="0,0,8,5"
                                   Command="{Binding SearchCommand}"/>
                        <Button Content="重置" Width="80" Margin="0,0,0,5"
                                   Command="{Binding ResetCommand}"/>
                    </WrapPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="批量删除" Width="90" Margin="0,0,10,0"
                                   Command="{Binding BatchDeleteCommand}"/>
                        <Button Content="清空日志" Width="90" Margin="0,0,10,0"
                                   Command="{Binding ClearAllCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid Grid.Row="1"
                      Margin="0,0,0,8"
                      ItemsSource="{Binding OperLogList}"
                      SelectedItem="{Binding SelectedLog}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      CanUserReorderColumns="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      RowHeaderWidth="0"
                      ColumnHeaderStyle="{StaticResource FluentDataGridColumnHeader}"
                      RowStyle="{StaticResource FluentDataGridRow}"
                      CellStyle="{StaticResource FluentDataGridCell}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Width="60" IsReadOnly="False">
                        <DataGridCheckBoxColumn.Header>
                            <CheckBox VerticalAlignment="Center" HorizontalAlignment="Center"
                                      IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=Page}, Mode=OneWay}"
                                      Command="{Binding DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                        </DataGridCheckBoxColumn.Header>
                        <DataGridCheckBoxColumn.Binding>
                            <Binding Path="IsSelected" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                        </DataGridCheckBoxColumn.Binding>
                    </DataGridCheckBoxColumn>

                    <DataGridTextColumn Header="日志编号" Binding="{Binding OperId}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="系统模块" Binding="{Binding Title}" Width="*" MinWidth="120" IsReadOnly="True"/>

                    <DataGridTemplateColumn Header="操作类型" Width="80" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock.Text>
                                        <Binding Path="BusinessTypeText"/>
                                    </TextBlock.Text>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BusinessType}" Value="1">
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BusinessType}" Value="2">
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BusinessType}" Value="3">
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="操作人员" Binding="{Binding OperName}" Width="100" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="操作地址" Binding="{Binding OperIp}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="操作地点" Binding="{Binding OperLocation}" Width="100" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="操作状态" Width="80" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock.Text>
                                        <Binding Path="StatusText"/>
                                    </TextBlock.Text>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource App.Success}"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="1">
                                                    <Setter Property="Foreground" Value="{DynamicResource App.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="操作时间" Binding="{Binding OperTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="消耗时间" Binding="{Binding CostTime, StringFormat={}{0}毫秒}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="操作" Width="120" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="详情" Width="50" Margin="0,0,6,0"
                                               
                                               Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"/>
                                    <Button Content="删除" Width="50" Margin="0,0,0,0"
                                               
                                               Command="{Binding DataContext.DeleteLogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2"
                    Padding="10"
                    Background="{DynamicResource App.PageBackground}"
                    BorderThickness="0">
                <ctrl:PagerControl
                    PageIndex="{Binding PageIndex, Mode=TwoWay}"
                    PageSize="{Binding PageSize, Mode=TwoWay}"
                    TotalItems="{Binding TotalItems}"
                    PageChangedCommand="{Binding LoadPageCommand}"/>
            </Border>
        </Grid>
    </Border>
</Page>
