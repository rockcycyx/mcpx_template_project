<Window x:Class="mcpx_template_project.Views.Pages.Admin.Notice.AddEditNoticeWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Admin.Notice"
      xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Admin.Notice"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      mc:Ignorable="d"
      Height="460" Width="600"
      WindowStartupLocation="CenterOwner"
      ResizeMode="NoResize"
      Background="{DynamicResource App.PageBackground}"
      Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="通知标题" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,15"
                 Text="{Binding NoticeTitle, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入通知标题"
                 MaxLength="100"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="类型" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,15"
                  SelectedValuePath="Tag"
                  SelectedValue="{Binding NoticeType}">
            <ComboBoxItem Content="通知" Tag="0"/>
            <ComboBoxItem Content="公告" Tag="1"/>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="2" Text="状态" VerticalAlignment="Center" Margin="20,0,10,15"/>
        <ui:ToggleSwitch Grid.Row="1" Grid.Column="3" Margin="20,0,0,15"
                         IsOn="{Binding IsStatusActive, Mode=TwoWay}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="内容" VerticalAlignment="Top" Margin="0,5,10,0"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,15"
                 Text="{Binding NoticeContent, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入通知内容"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"/>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource App.Danger}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="确定" Width="80" Margin="0,0,10,0"
                       Click="ConfirmBtn_Click"/>
            <Button Content="取消" Width="80" Margin="0,0,0,0"
                       Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
