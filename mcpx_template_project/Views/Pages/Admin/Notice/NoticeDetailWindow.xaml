<Window x:Class="mcpx_template_project.Views.Pages.Admin.Notice.NoticeDetailWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Admin.Notice"
      xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Admin.Notice"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      mc:Ignorable="d"
      Height="420" Width="620"
      WindowStartupLocation="CenterOwner"
      ResizeMode="NoResize"
      Background="{DynamicResource App.PageBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding NoticeTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="类型：" Foreground="{DynamicResource App.TextSecondary}"/>
            <TextBlock Text="{Binding NoticeTypeName}" Margin="0,0,16,0"/>
            <TextBlock Text="来源：" Foreground="{DynamicResource App.TextSecondary}"/>
            <TextBlock Text="{Binding Source}" Margin="0,0,16,0"/>
            <TextBlock Text="创建人：" Foreground="{DynamicResource App.TextSecondary}"/>
            <TextBlock Text="{Binding CreateBy}" Margin="0,0,16,0"/>
            <TextBlock Text="时间：" Foreground="{DynamicResource App.TextSecondary}"/>
            <TextBlock Text="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}"/>
        </StackPanel>

        <Border Grid.Row="3" Background="{DynamicResource App.CardBackground}" Padding="12" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding NoticeContent}" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="关闭" Width="80" Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>
