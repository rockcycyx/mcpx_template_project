<Window x:Class="mcpx_template_project.Views.Pages.Admin.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Admin"
        xmlns:converters="clr-namespace:mcpx_template_project.Converters"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        ui:WindowHelper.SystemBackdropType="Acrylic"
        mc:Ignorable="d"
        Title="系统登录" Width="450" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">

    <!-- 亚克力生效的关键：GlassFrameThickness=-1 把 DWM 玻璃框扩展到整个客户区，
         系统背景（亚克力模糊）才能透过 WPF 的透明像素显示出来。
         缺少这层玻璃面时，透明区域下方没有 DWM 背景面，会被渲染成纯黑
         （这正是登录窗此前亚克力不生效、整体发黑的根因；主窗口因已有 WindowChrome 而正常）。
         CaptionHeight=0 保持全窗口为 WPF 客户区，拖动仍由卡片 Border 上的 DragMove 处理。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="-1"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:SexConverter x:Key="SexConverter"/>

        <Style x:Key="FieldBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <DataTemplate x:Key="LoginFormTemplate">    
            <StackPanel Margin="40,30,40,30" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="/Assets/images/profile.png" Width="70" Height="70"/>
                    <TextBlock Text="mcpx_scaffold_project" FontSize="20" FontWeight="Bold"
                               Margin="0,12,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextAlignment="Center"/>
                    <TextBlock Text="Login" HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,15,0,15"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,22">
                    <Label Content="账号" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <TextBox FontSize="14" BorderThickness="0" Background="Transparent"
                                 Style="{x:Null}"
                                 Text="{Binding LoginBody.EmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="0"/>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,0,40">
                    <Label Content="密码" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Border Style="{StaticResource FieldBorderStyle}">
                        <PasswordBox FontSize="14" BorderThickness="0" Background="Transparent"
                                     Style="{x:Null}"
                                     vm:PasswordBoxHelper.Attach="True"
                                     vm:PasswordBoxHelper.BindPassword="{Binding LoginBody.Password, Mode=TwoWay}"
                                     VerticalContentAlignment="Center"
                                     Padding="0"/>
                    </Border>
                </StackPanel>

                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="登录" Height="46" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                            Command="{Binding LoginCommand}"/>
                    <Button Grid.Column="1" Content="取消" HorizontalAlignment="Center"
                            Height="46" FontSize="16" FontWeight="Bold"
                            Click="Cancel_Click" IsCancel="True"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="UserInfoTemplate">
            <StackPanel Margin="40,30,40,30" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="/Assets/images/profile.png" Width="70" Height="70"/>
                    <TextBlock Text="用户信息" FontSize="20" FontWeight="Bold"
                               Margin="0,12,0,20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextAlignment="Center"/>
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="账号" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentUser.UserName}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="昵称" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentUser.NickName}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="邮箱" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentUser.Email}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="手机号" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentUser.PhoneNumber}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="性别" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentUser.Sex, Converter={StaticResource SexConverter}}"
                               FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="更新时间" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentUser.UpdateTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                               FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="登出" Height="46" FontSize="16" FontWeight="Bold"
                            HorizontalAlignment="Center"
                            Command="{Binding LogoutCommand}"/>
                    <Button Grid.Column="1" Content="取消" HorizontalAlignment="Center"
                            Height="46" FontSize="16" FontWeight="Bold"
                            Click="Cancel_Click" IsCancel="True"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border MouseDown="WindowDrag_MouseDown" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Color="#888888" Opacity="0.35"/>
        </Border.Effect>

        <ContentControl Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource LoginFormTemplate}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource UserInfoTemplate}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Border>
</Window>
