<Page x:Class="mcpx_template_project.Views.Pages.Admin.Dept.PageDept"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Admin.Dept"
      xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Admin.Dept"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1200"
      Title="部门管理">
    <Page.Resources>
    </Page.Resources>

    <Border Background="{DynamicResource App.PageBackground}" Margin="6" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部搜索栏 -->
            <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource App.CardBackground}" BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="部门名称" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource App.TextSecondary}" FontSize="13"/>
                        <TextBox Width="200" Height="30" Margin="0,0,16,0"
                                 Text="{Binding SearchDeptName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入后按回车搜索"
                                 PreviewKeyDown="TxtDeptName_PreviewKeyDown"
                                 Padding="8,4" VerticalContentAlignment="Center"/>

                        <TextBlock Text="状态" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource App.TextSecondary}" FontSize="13"/>
                        <ComboBox Width="100" Margin="0,0,16,0"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding SearchStatus}">
                            <ComboBoxItem Content="全部" Tag=""/>
                            <ComboBoxItem Content="正常" Tag="0"/>
                            <ComboBoxItem Content="停用" Tag="1"/>
                        </ComboBox>

                        <Button Content="搜索" Width="80" Height="30" Margin="0,0,8,0"
                                Command="{Binding SearchCommand}"/>
                        <Button Content="重置" Width="80" Height="30"
                                Command="{Binding ResetCommand}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="新增" Width="90" Height="30"
                            Command="{Binding AddDeptCommand}"/>
                </Grid>
            </Border>

            <!-- 左右分栏 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="220"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：树形部门列表 -->
                <Border Grid.Column="0" Background="{DynamicResource App.CardBackground}" BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="部门列表" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextSecondary}" Margin="14,10,0,6"/>
                        <TreeView ItemsSource="{Binding DeptTree}"
                                  SelectedItemChanged="TreeView_SelectedItemChanged"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="13"
                                  Padding="4,0,4,8"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeptName}" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource App.Danger}" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value=""/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="1">
                                                            <Setter Property="Text" Value="停用"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource {x:Static ui:ThemeKeys.DefaultTreeViewItemStyleKey}}" TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </DockPanel>
                </Border>

                <!-- 分隔线 -->
                <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                              Background="{DynamicResource App.CardBorder}" ResizeBehavior="PreviousAndNext"/>

                <!-- 右侧：详情面板 -->
                <Border Grid.Column="2" Background="{DynamicResource App.CardBackground}">
                    <Grid>
                        <!-- 无选中状态 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDept}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="请选择左侧部门查看详情" FontSize="14" Foreground="{DynamicResource App.TextTertiary}"/>
                        </StackPanel>

                        <!-- 详情内容 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                            <StackPanel Margin="24,16,24,16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDept}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- 标题行 -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedDept.DeptName}" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                                        <!-- 状态标签 -->
                                        <Border CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource App.AccentSubtle}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedDept.Status}" Value="1">
                                                            <Setter Property="Background" Value="{DynamicResource App.AccentSubtle}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="正常"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource App.Success}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedDept.Status}" Value="1">
                                                                <Setter Property="Text" Value="停用"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Danger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- 字段详情 -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row0: 部门名称 / 上级部门 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="部门名称" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDept.DeptName}" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="上级部门" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="—"/>
                                                <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Row1: 显示排序 / 负责人 -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="显示排序" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDept.OrderNum}" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="负责人" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedDept.Leader}" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12"/>

                                    <!-- Row2: 联系电话 / 邮箱 -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="联系电话" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDept.Phone}" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="邮箱" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedDept.Email}" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Row3: 创建时间 / 更新时间 -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="创建时间" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDept.CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="更新时间" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding SelectedDept.UpdateTime, StringFormat=yyyy-MM-dd HH:mm}" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>

                                    <!-- Row4: 创建人 / 更新人 -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="创建人" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDept.CreateBy}" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="更新人" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding SelectedDept.UpdateBy}" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                </Grid>

                                <!-- 分隔线 -->
                                <Border Height="1" Background="{DynamicResource App.CardBorder}" Margin="0,8,0,16"/>

                                <!-- 操作按钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="修改" Width="80" Height="32" Margin="0,0,10,0"
                                            Command="{Binding EditDeptCommand}"
                                            CommandParameter="{Binding SelectedDept}"/>
                                    <Button Content="新增子部门" Width="110" Height="32" Margin="0,0,10,0"
                                            Command="{Binding AddChildDeptCommand}"
                                            CommandParameter="{Binding SelectedDept}"/>
                                    <Button Content="删除" Width="80" Height="32"
                                            Command="{Binding DeleteDeptCommand}"
                                            CommandParameter="{Binding SelectedDept}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Page>
