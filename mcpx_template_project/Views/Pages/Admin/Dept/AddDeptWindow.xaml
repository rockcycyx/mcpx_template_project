<Window x:Class="mcpx_template_project.Views.Pages.Admin.Dept.AddDeptWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Admin.Dept"
      xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Admin.Dept"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      mc:Ignorable="d" 
      Height="520" Width="640"
      WindowStartupLocation="CenterOwner"
      ResizeMode="NoResize"
      Background="{DynamicResource App.PageBackground}"
      Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="上级部门" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     IsReadOnly="True"
                     Text="{Binding SelectedParentDeptName, Mode=OneWay}"
                     ToolTip="请在下方树形结构中选择上级部门"/>
            <Button Grid.Column="1"
                    Content="清除"
                    Width="60"
                    Margin="5,0,0,0"
                    Command="{Binding ClearParentDeptCommand}"/>
        </Grid>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="部门名称" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,15"
                 Text="{Binding DeptName, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入部门名称"/>

        <TextBlock Grid.Row="1" Grid.Column="2" Text="显示排序" VerticalAlignment="Center" Margin="20,0,10,15"/>
        <TextBox Grid.Row="1" Grid.Column="3" Margin="20,0,0,15"
                 Text="{Binding OrderNum, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入显示排序"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="负责人" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,15"
                 Text="{Binding Leader, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入负责人"/>

        <TextBlock Grid.Row="2" Grid.Column="2" Text="联系电话" VerticalAlignment="Center" Margin="20,0,10,15"/>
        <TextBox Grid.Row="2" Grid.Column="3" Margin="20,0,0,15"
                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入联系电话"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="邮箱" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,15"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入邮箱"/>

        <TextBlock Grid.Row="3" Grid.Column="2" Text="部门状态" VerticalAlignment="Center" Margin="20,0,10,15"/>
        <ui:ToggleSwitch Grid.Row="3" Grid.Column="3" Margin="20,0,0,15"
                         IsOn="{Binding IsStatusActive, Mode=TwoWay}"/>

        <!-- 部门树形选择区域 -->
        <GroupBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Header="部门树形结构" Margin="0,0,0,10">
            <TreeView x:Name="DeptTreeView"
                      ItemsSource="{Binding DeptTree}"
                      SelectedItemChanged="DeptTreeView_SelectedItemChanged"
                      FontSize="13">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding DeptName}" VerticalAlignment="Center"/>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </GroupBox>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource App.Danger}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="确定" Width="80" Margin="0,0,10,0"
                       Click="ConfirmBtn_Click"/>
            <Button Content="取消" Width="80" Margin="0,0,0,0"
                       Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
