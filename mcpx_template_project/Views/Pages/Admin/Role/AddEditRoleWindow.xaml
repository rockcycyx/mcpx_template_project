<Window x:Class="mcpx_template_project.Views.Pages.Admin.Role.AddEditRoleWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Admin.Role"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      mc:Ignorable="d"
      Height="650" Width="680"
      WindowStartupLocation="CenterOwner"
      ResizeMode="NoResize"
      Background="{DynamicResource App.PageBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="280"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 角色名称 -->
        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="*" Foreground="{DynamicResource App.Danger}"/>
                <TextBlock Text="角色名称"/>
            </StackPanel>
        </TextBlock>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,15"
                 Text="{Binding RoleName, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入角色名称"/>

        <!-- 权限字符 -->
        <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="20,0,10,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="*" Foreground="{DynamicResource App.Danger}"/>
                <TextBlock Text="权限字符"/>
            </StackPanel>
        </TextBlock>
        <TextBox Grid.Row="0" Grid.Column="3" Margin="20,0,0,15"
                 Text="{Binding RoleKey, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入权限字符"/>

        <!-- 角色顺序 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="角色顺序" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,15"
                 Text="{Binding RoleSort, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入角色顺序"/>

        <!-- 状态 -->
        <TextBlock Grid.Row="1" Grid.Column="2" Text="状态" VerticalAlignment="Center" Margin="20,0,10,15"/>
        <ui:ToggleSwitch Grid.Row="1" Grid.Column="3" Margin="20,0,0,15"
                         IsOn="{Binding IsStatusActive, Mode=TwoWay}"/>

        <!-- 菜单权限 -->
        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,5,10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="*" Foreground="{DynamicResource App.Danger}" VerticalAlignment="Center"/>
                <TextBlock Text="菜单权限" VerticalAlignment="Center"/>
            </StackPanel>
        </TextBlock>
        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,5,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 操作按钮栏 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                <CheckBox Content="展开/折叠" 
                          IsChecked="{Binding IsExpandAll, Mode=TwoWay}"
                          Padding="5,2"
                          Margin="0,0,15,0"/>
                <CheckBox Content="全选/全不选" 
                          IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                          Padding="5,2"
                          Margin="0,0,15,0"/>
                <CheckBox Content="父子联动" 
                          IsChecked="{Binding IsCheckStrictly, Mode=TwoWay}"
                          Padding="5,2"/>
            </StackPanel>

            <!-- 菜单树（带滚动） -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource App.CardBackground}"
                    BorderBrush="{DynamicResource App.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <TreeView x:Name="MenuTreeView"
                          ItemsSource="{Binding MenuTree}"
                          FontSize="13"
                          Background="{DynamicResource App.CardBackground}"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <CheckBox Content="{Binding MenuName}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Checked="MenuCheckBox_CheckedChanged"
                                      Unchecked="MenuCheckBox_CheckedChanged"
                                      Padding="5,2"
                                      VerticalAlignment="Center"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>
        </Grid>

        <!-- 备注 -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="备注" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,0"
                 Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入备注"
                 AcceptsReturn="True"
                 Height="60"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource App.Danger}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="确定" Width="80" Margin="0,0,10,0"
                       Click="ConfirmBtn_Click"/>
            <Button Content="取消" Width="80" Margin="0,0,0,0"
                       Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
