<Page x:Class="mcpx_template_project.Views.Pages.Admin.UserCenter.PageUserCenter"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Admin.UserCenter"
      mc:Ignorable="d" 
      Background="{DynamicResource App.PageBackground}"
      Title="个人中心">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：个人信息展示 -->
        <Border Grid.Column="0" Background="{DynamicResource App.CardBackground}" BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="个人信息" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource App.TextSecondary}" Margin="0,0,0,16"/>
                
                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,20">
                    <Grid Width="120" Height="120" HorizontalAlignment="Center">
                        <!-- Copilot 动画头像：sprite 长图在 96x96 裁剪窗口里逐帧上移（等价 CSS background-position） -->
                        <Ellipse Fill="{DynamicResource App.Accent}" Opacity="0.12"/>
                        <Canvas Width="96" Height="96"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ClipToBounds="True">
                            <Image x:Name="AvatarImage"
                                   Source="/Assets/images/Copilot_sprite.png"
                                   Canvas.Left="0" Canvas.Top="0"
                                   Width="96" Height="5184"
                                   Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Canvas>
                    </Grid>
                </StackPanel>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="👤 用户名称" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentUser.UserName, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📱 手机号码" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentUser.PhoneNumber, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="✉️ 用户邮箱" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentUser.Email, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🏢 所属部门" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding DeptName, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="👥 所属角色" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding RoleName, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📅 创建日期" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentUser.CreateTime, Mode=OneWay, StringFormat='yyyy-MM-dd HH:mm:ss'}" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 分隔线 -->
        <Separator Grid.Column="1" Width="1" Background="{DynamicResource App.CardBorder}" Margin="16,0"/>

        <!-- 右侧：详细信息/修改密码 -->
        <Border Grid.Column="2" Background="{DynamicResource App.CardBackground}" BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
            <TabControl Background="Transparent" BorderThickness="0">
                <!-- 自定义 TabItem 样式：避免 iNKORE 默认样式里 TabStripPlacement 的 FindAncestor 绑定在切页卸载时报错 -->
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="16,10"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Grid>
                                        <Border x:Name="ContentBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6,6,0,0"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="Underline"
                                                Height="3" Width="26"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,3"
                                                Background="{DynamicResource App.Accent}"
                                                CornerRadius="2"
                                                Visibility="Collapsed"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource App.Hover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource App.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="基本资料">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                        <StackPanel Margin="20,10">
                            <!-- 用户昵称 -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="* 用户昵称" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding NickName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" Padding="8,4" VerticalContentAlignment="Center"
                                         BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="1"/>
                            </Grid>

                            <!-- 手机号码 -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="* 手机号码" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" Padding="8,4" VerticalContentAlignment="Center"
                                         BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="1"/>
                            </Grid>

                            <!-- 邮箱 -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="* 邮箱" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="32" Padding="8,4" VerticalContentAlignment="Center"
                                         BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="1"/>
                            </Grid>

                            <!-- 性别 -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="性别" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="RadioMale" Content="男" GroupName="SexGroup" 
                                                 Checked="RadioMale_Checked" Padding="10,0" Margin="0,0,20,0"/>
                                    <RadioButton x:Name="RadioFemale" Content="女" GroupName="SexGroup"
                                                 Checked="RadioFemale_Checked" Padding="10,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 保存/重置 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="保存"
                                        Command="{Binding SaveProfileCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Margin="0,0,10,0"/>
                                <Button Content="重置"
                                        Command="{Binding ResetProfileCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="修改密码">
                    <StackPanel Margin="20,10">
                        <!-- 原密码 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* 原密码" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                            <PasswordBox Grid.Column="1" x:Name="OldPasswordBox"
                                         Height="32" Padding="8,4" VerticalContentAlignment="Center"
                                         BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="1"/>
                        </Grid>

                        <!-- 新密码 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* 新密码" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                            <PasswordBox Grid.Column="1" x:Name="NewPasswordBox"
                                         Height="32" Padding="8,4" VerticalContentAlignment="Center"
                                         BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="1"/>
                        </Grid>

                        <!-- 确认密码 -->
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* 确认密码" FontSize="13" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                            <PasswordBox Grid.Column="1" x:Name="ConfirmPasswordBox"
                                         Height="32" Padding="8,4" VerticalContentAlignment="Center"
                                         BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="1"/>
                        </Grid>

                        <!-- 密码规则提示 -->
                        <TextBlock Text="密码长度不能少于6位" FontSize="12" Foreground="{DynamicResource App.TextTertiary}" Margin="0,0,0,20"/>

                        <!-- 保存 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="保存" 
                                    Click="ChangePassword_Click"
                                    Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Page>
