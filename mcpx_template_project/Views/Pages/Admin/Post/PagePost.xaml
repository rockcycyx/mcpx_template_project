<Page x:Class="mcpx_template_project.Views.Pages.Admin.Post.PagePost"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Admin.Post"
      xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Admin.Post"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ctrl="clr-namespace:mcpx_template_project.Views.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1200"
      Title="岗位管理">
    <Border Background="{DynamicResource App.PageBackground}" Margin="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="10" Background="{DynamicResource App.CardBackground}" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="岗位编码" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Width="150" Margin="0,0,10,0"
                                 Text="{Binding SearchPostCode, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入后按回车搜索"
                                 PreviewKeyDown="TxtPostCode_PreviewKeyDown"/>

                        <TextBlock Text="岗位名称" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Width="150" Margin="0,0,10,0"
                                 Text="{Binding SearchPostName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入后按回车搜索"
                                 PreviewKeyDown="TxtPostName_PreviewKeyDown"/>

                        <TextBlock Text="状态" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox Width="100" Margin="0,0,10,0"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding SearchStatus}">
                            <ComboBoxItem Content="全部" Tag=""/>
                            <ComboBoxItem Content="正常" Tag="0"/>
                            <ComboBoxItem Content="停用" Tag="1"/>
                        </ComboBox>

                        <Button Content="搜索" Width="80" Margin="0,0,8,0"
                                   Command="{Binding SearchCommand}"/>
                        <Button Content="重置" Width="80" Margin="0,0,0,0"
                                   Command="{Binding ResetCommand}"/>
                    </StackPanel>

                    <ctrl:ActionBar Grid.Row="1"
                        AddCommand="{Binding AddPostCommand}"
                        DeleteCommand="{Binding BatchDeleteCommand}"
                        ImportCommand="{Binding ImportCommand}"
                        ExportCommand="{Binding ExportCommand}"/>
                </Grid>
            </Border>

            <DataGrid Grid.Row="1"
                      Margin="0,0,0,8"
                      ItemsSource="{Binding PostList}"
                      SelectedItem="{Binding SelectedPost}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      CanUserReorderColumns="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      RowHeaderWidth="0"
                      ColumnHeaderStyle="{StaticResource FluentDataGridColumnHeader}"
                      RowStyle="{StaticResource FluentDataGridRow}"
                      CellStyle="{StaticResource FluentDataGridCell}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Width="60" IsReadOnly="False">
                        <DataGridCheckBoxColumn.Header>
                            <CheckBox VerticalAlignment="Center" HorizontalAlignment="Center"
                                      IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=Page}, Mode=OneWay}"
                                      Command="{Binding DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                        </DataGridCheckBoxColumn.Header>
                        <DataGridCheckBoxColumn.Binding>
                            <Binding Path="IsSelected" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                        </DataGridCheckBoxColumn.Binding>
                    </DataGridCheckBoxColumn>

                    <DataGridTextColumn Header="岗位编号" Binding="{Binding PostId}" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="岗位编码" Binding="{Binding PostCode}" Width="*" MinWidth="100" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="岗位名称" Binding="{Binding PostName}" Width="*" MinWidth="100" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="排序" Binding="{Binding PostSort}" Width="60" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="状态" Width="80" IsReadOnly="True">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:ToggleSwitch IsOn="{Binding Status, Mode=OneWay, Converter={StaticResource StatusToBoolConverter}}"
                                                ctrl:ToggleSwitchCommandBehavior.Command="{Binding DataContext.SwitchStatusCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                ctrl:ToggleSwitchCommandBehavior.CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Width="*" MinWidth="120" IsReadOnly="True">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCenterText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="操作" Width="180" IsReadOnly="True">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="修改" Width="50" Margin="0,0,6,0"
                               
                               Command="{Binding DataContext.EditPostCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               CommandParameter="{Binding}"/>
                                    <Button Content="删除" Width="50" Margin="0,0,6,0"
                               
                               Command="{Binding DataContext.DeletePostCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               CommandParameter="{Binding}"/>
                                    <Button Content="更多" Width="50" Margin="0,0,0,0"
                               />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2"
                    Padding="10"
                    Background="{DynamicResource App.PageBackground}"
                    BorderThickness="0">
                <ctrl:PagerControl
                    PageIndex="{Binding PageIndex, Mode=TwoWay}"
                    PageSize="{Binding PageSize, Mode=TwoWay}"
                    TotalItems="{Binding TotalItems}"
                    PageChangedCommand="{Binding LoadPageCommand}"/>
            </Border>
        </Grid>
    </Border>
</Page>
