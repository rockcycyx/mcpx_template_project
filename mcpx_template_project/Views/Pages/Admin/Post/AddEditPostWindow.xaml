<Window x:Class="mcpx_template_project.Views.Pages.Admin.Post.AddEditPostWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Admin.Post"
      xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Admin.Post"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      mc:Ignorable="d" 
      Height="480" Width="580"
      WindowStartupLocation="CenterOwner"
      ResizeMode="NoResize"
      Background="{DynamicResource App.PageBackground}"
      Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="岗位编码" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,15"
                 Text="{Binding PostCode, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入岗位编码"
                 MaxLength="64"/>

        <TextBlock Grid.Row="0" Grid.Column="2" Text="岗位名称" VerticalAlignment="Center" Margin="20,0,10,15"/>
        <TextBox Grid.Row="0" Grid.Column="3" Margin="20,0,0,15"
                 Text="{Binding PostName, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入岗位名称"
                 MaxLength="50"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="岗位顺序" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,15"
                 Text="{Binding PostSort, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入岗位顺序"
                 Height="32"/>

        <TextBlock Grid.Row="1" Grid.Column="2" Text="岗位状态" VerticalAlignment="Center" Margin="20,0,10,15"/>
        <ui:ToggleSwitch Grid.Row="1" Grid.Column="3" Margin="20,0,0,15"
                         IsOn="{Binding IsStatusActive, Mode=TwoWay}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="备注" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,15"
                 Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="请输入备注"
                 MaxLength="500"
                 AcceptsReturn="True"
                 Height="80"
                 VerticalContentAlignment="Top"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource App.Danger}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="确定" Width="80" Margin="0,0,10,0"
                       Click="ConfirmBtn_Click"/>
            <Button Content="取消" Width="80" Margin="0,0,0,0"
                       Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
