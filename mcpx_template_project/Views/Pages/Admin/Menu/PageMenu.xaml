<Page x:Class="mcpx_template_project.Views.Pages.Admin.Menu.PageMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:mcpx_template_project.Views.Pages.Admin.Menu"
      xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Admin.Menu"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1200"
      Title="菜单管理">
    <Page.Resources>
    </Page.Resources>

    <Border Background="{DynamicResource App.PageBackground}" Margin="6" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部搜索栏 -->
            <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource App.CardBackground}" BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="菜单名称" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource App.TextSecondary}" FontSize="13"/>
                        <TextBox Width="200" Height="30" Margin="0,0,16,0"
                                 Text="{Binding SearchMenuName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="输入后按回车搜索"
                                 PreviewKeyDown="TxtMenuName_PreviewKeyDown"
                                 Padding="8,4" VerticalContentAlignment="Center"/>

                        <TextBlock Text="状态" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource App.TextSecondary}" FontSize="13"/>
                        <ComboBox Width="100" Margin="0,0,16,0"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding SearchStatus}">
                            <ComboBoxItem Content="全部" Tag=""/>
                            <ComboBoxItem Content="正常" Tag="0"/>
                            <ComboBoxItem Content="停用" Tag="1"/>
                        </ComboBox>

                        <Button Content="搜索" Width="80" Height="30" Margin="0,0,8,0"
                                Command="{Binding SearchCommand}"/>
                        <Button Content="重置" Width="80" Height="30"
                                Command="{Binding ResetCommand}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="新增菜单" Width="90" Height="30"
                            Command="{Binding AddMenuCommand}"/>
                </Grid>
            </Border>

            <!-- 左右分栏 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="220"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：树形菜单 -->
                <Border Grid.Column="0" Background="{DynamicResource App.CardBackground}" BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="菜单树" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextSecondary}" Margin="14,10,0,6"/>
                        <TreeView ItemsSource="{Binding MenuTree}"
                                  SelectedItemChanged="TreeView_SelectedItemChanged"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="13"
                                  Padding="4,0,4,8">
                            <TreeView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource {x:Static ui:ThemeKeys.DefaultTreeViewItemStyleKey}}" TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 类型小圆点 -->
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource App.Accent}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MenuType}" Value="M">
                                                            <Setter Property="Fill" Value="{DynamicResource App.Accent}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MenuType}" Value="C">
                                                            <Setter Property="Fill" Value="{DynamicResource App.Success}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding MenuType}" Value="F">
                                                            <Setter Property="Fill" Value="{DynamicResource App.Warning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding MenuName}" Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                                        <!-- 停用标记 -->
                                        <TextBlock FontSize="10" Foreground="{DynamicResource App.Danger}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Text="停" Padding="2,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="1">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Border>

                <!-- 分隔线 -->
                <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                              Background="{DynamicResource App.CardBorder}" ResizeBehavior="PreviousAndNext"/>

                <!-- 右侧：详情面板 -->
                <Border Grid.Column="2" Background="{DynamicResource App.CardBackground}">
                    <Grid>
                        <!-- 无选中状态 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMenu}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="请选择左侧菜单查看详情" FontSize="14" Foreground="{DynamicResource App.TextTertiary}"/>
                        </StackPanel>

                        <!-- 详情内容 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                            <StackPanel Margin="24,16,24,16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMenu}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- 标题行 -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedMenu.MenuName}" FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource App.TextSecondary}" VerticalAlignment="Center"/>
                                        <!-- 类型标签 -->
                                        <Border CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource App.AccentSubtle}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedMenu.MenuType}" Value="M">
                                                            <Setter Property="Background" Value="{DynamicResource App.AccentSubtle}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedMenu.MenuType}" Value="C">
                                                            <Setter Property="Background" Value="{DynamicResource App.AccentSubtle}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedMenu.MenuType}" Value="F">
                                                            <Setter Property="Background" Value="{DynamicResource App.AccentSubtle}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedMenu.MenuType}" Value="M">
                                                                <Setter Property="Text" Value="目录"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Accent}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedMenu.MenuType}" Value="C">
                                                                <Setter Property="Text" Value="菜单"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Success}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedMenu.MenuType}" Value="F">
                                                                <Setter Property="Text" Value="按钮"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Warning}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <!-- 状态标签 -->
                                        <Border CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource App.AccentSubtle}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedMenu.Status}" Value="1">
                                                            <Setter Property="Background" Value="{DynamicResource App.AccentSubtle}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="正常"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource App.Success}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedMenu.Status}" Value="1">
                                                                <Setter Property="Text" Value="停用"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource App.Danger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- 字段详情 -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row0: 上级菜单 / 显示排序 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="上级菜单" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedMenu.ParentName}" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="显示排序" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedMenu.OrderNum}" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12"/>

                                    <!-- Row1: 组件路径 -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="组件路径" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedMenu.Component}" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Row2: 权限标识 / 菜单图标 -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="权限标识" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedMenu.Perms}" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="菜单图标" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedMenu.Icon}" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Row3: 显示状态 / 菜单状态 -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="显示状态" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="—"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedMenu.Visible}" Value="0">
                                                        <Setter Property="Text" Value="显示"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedMenu.Visible}" Value="1">
                                                        <Setter Property="Text" Value="隐藏"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="菜单状态" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="—"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedMenu.Status}" Value="0">
                                                        <Setter Property="Text" Value="正常"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedMenu.Status}" Value="1">
                                                        <Setter Property="Text" Value="停用"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Row5: 创建时间 / 更新时间 -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="创建时间" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedMenu.CreateTime, StringFormat=yyyy-MM-dd HH:mm}" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="更新时间" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding SelectedMenu.UpdateTime, StringFormat=yyyy-MM-dd HH:mm}" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"/>

                                    <!-- Row6: 备注 -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="备注" Foreground="{DynamicResource App.TextTertiary}" FontSize="13" Margin="0,0,0,12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedMenu.Remark}" Foreground="{DynamicResource App.TextSecondary}" FontSize="13" Margin="0,0,0,12"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 分隔线 -->
                                <Border Height="1" Background="{DynamicResource App.CardBorder}" Margin="0,8,0,16"/>

                                <!-- 操作按钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="修改" Width="80" Height="32" Margin="0,0,10,0"
                                            Command="{Binding EditMenuCommand}"
                                            CommandParameter="{Binding SelectedMenu}"/>
                                    <Button Content="新增子菜单" Width="100" Height="32" Margin="0,0,10,0"
                                            Command="{Binding AddChildMenuCommand}"
                                            CommandParameter="{Binding SelectedMenu}"/>
                                    <Button Content="删除" Width="80" Height="32"
                                            Command="{Binding DeleteMenuCommand}"
                                            CommandParameter="{Binding SelectedMenu}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Page>
