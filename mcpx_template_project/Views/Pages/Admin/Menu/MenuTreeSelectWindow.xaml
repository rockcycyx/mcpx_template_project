<Window x:Class="mcpx_template_project.Views.Pages.Admin.Menu.MenuTreeSelectWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:mcpx_template_project.ViewModels.Admin.Menu"
      mc:Ignorable="d"
      Height="450" Width="400"
      WindowStartupLocation="CenterOwner"
      ResizeMode="NoResize"
      Title="选择上级菜单"
      Background="{DynamicResource App.PageBackground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TreeView x:Name="MenuTreeView"
                  ItemsSource="{Binding}"
                  SelectedItemChanged="MenuTreeView_SelectedItemChanged"
                  FontSize="13">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding MenuName}" VerticalAlignment="Center"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="80" Margin="0,0,10,0"
                    Click="ConfirmBtn_Click"/>
            <Button Content="取消" Width="80" Margin="0,0,0,0"
                    Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
