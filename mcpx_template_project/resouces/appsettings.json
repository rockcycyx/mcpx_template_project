{
    "ConnectionStrings": {
        "SqliteDb": "Data Source=|DataDirectory|\\mcpx_template_project.db"
    },
  "SecsGem": {
    "IpAddress": "0.0.0.0",
    "Port": 5000,
    "DeviceId": 0,
    "ConnectMode": "manual",
    "T3": 45000,
    "T5": 10000,
    "T6": 5000,
    "T7": 10000,
    "T8": 5000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  }
}