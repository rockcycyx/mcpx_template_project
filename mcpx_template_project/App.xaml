<Application x:Class="mcpx_template_project.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:mcpx_template_project"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
             xmlns:dg="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             
             ShutdownMode="OnExplicitShutdown"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===================== Fluent 语义资源（映射到 iNKORE Brush 资源） ===================== -->
            <!-- 兼容旧 UiBrush.* 引用，直接映射到 Fluent 现成 Brush 资源 -->
            <SolidColorBrush x:Key="UiBrush.Text" Color="{DynamicResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="UiBrush.Background" Color="{DynamicResource SolidBackgroundFillColorBase}" />
            <SolidColorBrush x:Key="UiBrush.Border" Color="{DynamicResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="PressedForeground" Color="{DynamicResource TextFillColorPrimary}"/>

            <!-- 覆盖系统高亮色：让原生 DataGrid 的选中态使用 Fluent 主题强调色（默认是系统蓝，且优先级高于样式 Setter） -->
            <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightBrushKey}" Color="{DynamicResource AccentFillColorSecondary}" />
            <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightTextBrushKey}" Color="{DynamicResource TextFillColorPrimary}" />

            <!-- 页面/内容区背景（配合 Mica 窗口） -->
            <SolidColorBrush x:Key="App.PageBackground" Color="{DynamicResource SolidBackgroundFillColorBase}" />
            <!-- 卡片/面板背景 -->
            <SolidColorBrush x:Key="App.CardBackground" Color="{DynamicResource SolidBackgroundFillColorSecondary}" />
            <!-- 卡片边框 -->
            <SolidColorBrush x:Key="App.CardBorder" Color="{DynamicResource ControlStrokeColorDefault}" />
            <!-- 次级文字 -->
            <SolidColorBrush x:Key="App.TextSecondary" Color="{DynamicResource TextFillColorSecondary}" />
            <!-- 次要文字（更弱） -->
            <SolidColorBrush x:Key="App.TextTertiary" Color="{DynamicResource TextFillColorTertiary}" />
            <!-- 危险/错误色 -->
            <SolidColorBrush x:Key="App.Danger" Color="{DynamicResource SystemFillColorCritical}" />
            <!-- 成功色 -->
            <SolidColorBrush x:Key="App.Success" Color="{DynamicResource SystemFillColorSuccess}" />
            <!-- 警告色 -->
            <SolidColorBrush x:Key="App.Warning" Color="{DynamicResource SystemFillColorCaution}" />
            <!-- 信息/强调色（Accent） -->
            <SolidColorBrush x:Key="App.Accent" Color="{DynamicResource AccentFillColorDefault}" />
            <!-- 强调色浅背景（选中态） -->
            <SolidColorBrush x:Key="App.AccentSubtle" Color="{DynamicResource AccentFillColorSecondary}" />
            <!-- 悬停色 -->
            <SolidColorBrush x:Key="App.Hover" Color="{DynamicResource ControlFillColorSecondary}" />

            <!-- ===================== 全局 DataGrid 样式（Fluent 完整重渲染） ===================== -->
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="Transparent"/>
                <Setter Property="RowHeight" Value="44"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <!-- 行：悬停/选中背景在模板触发器里以 TargetName 绘制（优先级最高，不会被系统色盖住） -->
            <Style x:Key="FluentDataGridRow" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridRow">
                            <Border x:Name="RowBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <dg:DataGridCellsPresenter
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    <dg:DataGridDetailsPresenter Grid.Row="1"
                                                                 Visibility="{TemplateBinding DetailsVisibility}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource App.Hover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource App.AccentSubtle}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 列头：Fluent 扁平 + 底部分隔线 + 排序箭头 + 可拖拽列宽 -->
            <Style x:Key="FluentDataGridColumnHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}"/>
                <Setter Property="Background" Value="{DynamicResource App.CardBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid>
                                <Border x:Name="HeaderBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                        <ContentPresenter
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        <TextBlock x:Name="SortArrow"
                                                   Margin="5,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="8"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <Thumb x:Name="PART_LeftHeaderGripper"
                                       Width="6" HorizontalAlignment="Left"
                                       Background="Transparent" Cursor="SizeWE"/>
                                <Thumb x:Name="PART_RightHeaderGripper"
                                       Width="6" HorizontalAlignment="Right"
                                       Background="Transparent" Cursor="SizeWE"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter TargetName="SortArrow" Property="Text" Value="&#xE70E;"/>
                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter TargetName="SortArrow" Property="Text" Value="&#xE70D;"/>
                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource App.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 单元格：始终透明，整行统一高亮；内容垂直居中（修复列间上下不齐） -->
            <Style x:Key="FluentDataGridCell" TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 文本列水平居中（页面 ElementStyle 统一引用） -->
            <Style x:Key="DataGridCenterText" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <!-- 隐式样式兜底（注意：DataGridColumnHeader 的隐式样式在 WPF 中不可靠，
                 必须在 DataGrid 上显式设置 ColumnHeaderStyle，见各页面） -->
            <Style TargetType="DataGridRow" BasedOn="{StaticResource FluentDataGridRow}"/>
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}"/>
            <Style TargetType="DataGridCell" BasedOn="{StaticResource FluentDataGridCell}"/>

            <!-- ===================== 全局 TabItem 样式（覆盖 iNKORE 默认） ===================== -->
            <!-- iNKORE 的 DefaultTabItemStyle 在 Style.Triggers 里用 FindAncestor 绑 TabStripPlacement，
                 当 TabItem 脱离 TabControl 视觉树（页签卸载/缓存/切页）时报「找不到源」绑定错误。
                 这里用自定义 Template 全局覆盖，彻底移除该 FindAncestor 绑定。 -->
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <Border x:Name="ContentBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6,6,0,0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <Border x:Name="Underline"
                                        Height="3" Width="26"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,3"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="2"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================== 强调（Accent）按钮 ===================== -->
            <Style x:Key="AccentButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                <Setter Property="Padding" Value="24,8"/>
            </Style>

            <!-- ===================== 转换器 ===================== -->
            <!-- Status字符串 → bool 转换器 -->
            <local:StatusToBoolConverter x:Key="StatusToBoolConverter"/>
            <!-- PlcTrigger.Status（1启用/0停用） → bool 转换器 -->
            <local:TriggerStatusToBoolConverter x:Key="TriggerStatusToBoolConverter"/>
            <!-- int → string 转换器（0 显示空、空输入回退 0，避免 TextBox 空值 ConvertBack 报错） -->
            <local:IntConverter x:Key="IntConverter"/>
            <!-- Boolean → Visibility 转换器 -->
            <controls:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <!-- Boolean 反转 → Visibility 转换器 -->
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <!-- 字符串非空 → Visibility 转换器 -->
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <!-- 字符串为空 → Visibility 转换器（反向） -->
            <local:StringToInverseVisibilityConverter x:Key="StringToInverseVisibilityConverter"/>
            <!-- 权限标识 → Visibility 转换器（按钮级权限控制） -->
            <local:PermToVisibilityConverter x:Key="PermToVisibilityConverter"/>
            <!-- 菜单图标 → Segoe Fluent Icons 字形（sys_menu.icon 动态加载） -->
            <local:MenuIconConverter x:Key="MenuIconConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>