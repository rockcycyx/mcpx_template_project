<Window x:Class="mcpx_template_project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mcpx_template_project"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        ui:WindowHelper.SystemBackdropType="Acrylic"
        mc:Ignorable="d"
        x:Name="MainWindowElement"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        Icon="/Assets/images/profile.png"
        Topmost="False" 
        Title="mcpx_scaffold_project" Height="680" Width="1005">

    <!-- 自绘边框控制：收回原生 NC 缩放框（否则亚克力会透出一圈"系统边框"），
         CaptionHeight=48 让顶部 48px 成为原生拖动区（拖动/双击最大化/贴边均原生生效） -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- 根层铺一层半透明 Fluent 色调：亚克力模糊从其下透出，
         同时消除相邻面板拼接处的透明缝隙（黑线） -->
    <DockPanel Background="{DynamicResource LayerFillColorDefaultBrush}">
        <Border DockPanel.Dock="Top" Height="48" Background="Transparent" BorderBrush="{DynamicResource UiBrush.Border}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左：logo + 项目名（可拖动） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="/Assets/images/profile.png" Height="28" Width="28" Margin="0,0,10,0"/>
                    <TextBlock FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"
                               Text="mcpx_scaffold_project"/>
                </StackPanel>

                <!-- 右：窗口控制按钮（IsHitTestVisibleInChrome=True 让按钮在 NC 拖动区内仍可点击） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- 最小化 -->
                    <Button x:Name="MinimizeButton" Width="46" Height="48" Padding="0" BorderThickness="0"
                            Background="Transparent" Click="MinimizeButton_Click"
                            ToolTip="最小化">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChromeMinimize}" FontSize="12"/>
                    </Button>
                    <!-- 最大化 / 还原 -->
                    <Button x:Name="MaximizeButton" Width="46" Height="48" Padding="0" BorderThickness="0"
                            Background="Transparent" Click="MaximizeButton_Click"
                            ToolTip="最大化">
                        <ui:FontIcon x:Name="MaximizeIcon" Icon="{x:Static ui:SegoeFluentIcons.ChromeMaximize}" FontSize="12"/>
                    </Button>
                    <!-- 关闭 -->
                    <Button x:Name="CloseButton" Width="46" Height="48" Padding="0" BorderThickness="0"
                            Background="Transparent" Click="CloseButton_Click"
                            ToolTip="关闭">
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChromeClose}" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Height="28" Background="Transparent" BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="0,1,0,0">
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" FontSize="11" Foreground="{DynamicResource App.TextSecondary}">
                ©2026 Cai Yuxi 版权所有 | 技术支持：Rudeus4c@outlook.com
            </TextBlock>
        </Border>

        <Border DockPanel.Dock="Right" Width="46" Background="Transparent" BorderBrush="{DynamicResource App.CardBorder}" BorderThickness="1,0,0,0">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,8,0,0">

                <Button Margin="0,0,0,8" Width="36" Height="36" Padding="0" BorderThickness="0" Background="Transparent"
                Command="{Binding ShowSerialConfigCommand}"
                ToolTipService.InitialShowDelay="0"
                ToolTipService.Placement="Left"
                ToolTipService.HorizontalOffset="0"
                ToolTipService.VerticalOffset="0">
                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.MapDrive}" FontSize="20"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button.ToolTip>
                        <ToolTip Content="通讯设定" />
                    </Button.ToolTip>
                </Button>

                <!-- SECS/GEM 设定：Equipment(Passive) 端监听配置 -->
                <Button Margin="0,0,0,8" Width="36" Height="36" Padding="0" BorderThickness="0" Background="Transparent"
                Command="{Binding ShowSecsGemCommand}"
                ToolTipService.InitialShowDelay="0"
                ToolTipService.Placement="Left"
                ToolTipService.HorizontalOffset="0"
                ToolTipService.VerticalOffset="0">
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Iot_24_Regular}" FontSize="20"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button.ToolTip>
                        <ToolTip Content="SECS/GEM 设定" />
                    </Button.ToolTip>
                </Button>

                <!-- 实时监控：打开监控窗口，定时批量读取已连接通讯设定的PLC点位 -->
                <Button Margin="0,0,0,8" Width="36" Height="36" Padding="0" BorderThickness="0" Background="Transparent"
                Command="{Binding ShowPlcMonitorCommand}"
                ToolTipService.InitialShowDelay="0"
                ToolTipService.Placement="Left"
                ToolTipService.HorizontalOffset="0"
                ToolTipService.VerticalOffset="0">
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Gauge_24_Regular}" FontSize="20"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button.ToolTip>
                        <ToolTip Content="实时监控" />
                    </Button.ToolTip>
                </Button>

                <Button Margin="0,0,0,8" Width="36" Height="36" Padding="0" BorderThickness="0" Background="Transparent"
                Click="ToolsBtn_Click"
                ToolTipService.InitialShowDelay="0"
                ToolTipService.Placement="Left"
                ToolTipService.HorizontalOffset="0"
                ToolTipService.VerticalOffset="0">
                    <Grid>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.DeveloperTools}" FontSize="20"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Popup x:Name="ToolsPopuo"
                           IsOpen="{Binding IsToolsPopupOpen}"
                           HorizontalOffset="-8"
                           StaysOpen="False"
                           Placement="Left"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                            <Border Background="{DynamicResource UiBrush.Background}" 
                                BorderBrush="{DynamicResource UiBrush.Border}" 
                                BorderThickness="1" 
                                CornerRadius="8"
                                Padding="8">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="3" Opacity="0.25" BlurRadius="6"/>
                                </Border.Effect>

                                <StackPanel>
                                    <Button Tag="Poll" Margin="0,0,0,5" Height="50"
                                            Command="{Binding ToolsOpenCommand}" CommandParameter="Poll">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Modus Poll" HorizontalAlignment="Center" FontSize="10" />
                                        </StackPanel>
                                        <Button.ToolTip>
                                            <ToolTip Content="主站" />
                                        </Button.ToolTip>
                                    </Button>
                                    <Button Tag="Slave" Margin="0,0,0,5" Height="50"
                                            Command="{Binding ToolsOpenCommand}" CommandParameter="Slave">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Modbus Slave" HorizontalAlignment="Center" FontSize="10" />
                                        </StackPanel>
                                        <Button.ToolTip>
                                            <ToolTip Content="从站" />
                                        </Button.ToolTip>
                                    </Button>
                                    <Button Tag="VSPD" Margin="0,0,0,0" Height="50"
                                            Command="{Binding ToolsOpenCommand}" CommandParameter="VSPD">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="VSPD" HorizontalAlignment="Center" FontSize="10" />
                                        </StackPanel>
                                        <Button.ToolTip>
                                            <ToolTip Content="虚拟串口驱动" />
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Button>
                
                <Button Margin="0,0,0,8" Width="36" Height="36" Padding="0" BorderThickness="0" Background="Transparent"
                Command="{Binding ToolsOpenCommand}"
                CommandParameter="GitHub"
                ToolTipService.InitialShowDelay="0"
                ToolTipService.Placement="Left"
                ToolTipService.HorizontalOffset="0"
                ToolTipService.VerticalOffset="0"
                Tag="GitHub">
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.CodeCs_16_Regular}" FontSize="20"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button.ToolTip>
                        <ToolTip Content="获取源码？" />
                    </Button.ToolTip>
                </Button>
            </StackPanel>
    </Border>

        <ui:NavigationView x:Name="NavigationViewRoot"
                PaneDisplayMode="Left"
                IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
                IsPaneToggleButtonVisible="True"
                IsSettingsVisible="False"
                IsBackButtonVisible="Collapsed"
                OpenPaneLength="232"
                CompactPaneLength="56"
                PaneTitle="菜单导航"
                ItemInvoked="NavigationView_ItemInvoked"
                Background="Transparent">
            <ui:NavigationView.AutoSuggestBox>
                <!-- 注意：AutoSuggestBox.TextProperty 的元数据是普通 PropertyMetadata（BindsTwoWayByDefault=false），
                     未显式写 Mode=TwoWay 时 WPF 会按 OneWay 绑定，输入内容永远回写不到 ViewModel，搜索随即失效。 -->
                <ui:AutoSuggestBox PlaceholderText="搜索菜单"
                                   Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   VerticalAlignment="Center"
                                   Margin="4,4,4,8"/>
            </ui:NavigationView.AutoSuggestBox>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="个人中心" Tag="UserCenter" SelectsOnInvoked="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Contact}" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="退出登录" Tag="Logout" SelectsOnInvoked="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.SignOut}" FontSize="16"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}">
            <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Margin="8,6,8,2"
                        ui:TabControlHelper.IsAddTabButtonVisible="False"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        ItemContainerStyle="{DynamicResource NavTabItemStyle}">
                <TabControl.Resources>
                    <Style x:Key="NavTabItemStyle" TargetType="TabItem">
                        <Setter Property="Foreground" Value="{DynamicResource UiBrush.Text}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Content" Value="{Binding Frame}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Grid>
                                        <Border x:Name="ContentBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6,6,0,0"
                                                Padding="14,7"
                                                Margin="1,0"
                                                PreviewMouseRightButtonUp="TabItem_PreviewMouseRightButtonUp">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="关闭其他标签页" Click="ContextMenu_CloseOtherTabs"/>
                                                    <MenuItem Header="关闭所有标签页" Click="ContextMenu_CloseAllTabs"/>
                                                    <Separator/>
                                                    <MenuItem Header="关闭左侧标签页" Click="ContextMenu_CloseLeftTabs"/>
                                                    <MenuItem Header="关闭右侧标签页" Click="ContextMenu_CloseRightTabs"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <ContentPresenter ContentSource="Header"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="Underline"
                                                Height="3"
                                                Width="26"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,3"
                                                Background="{DynamicResource App.Accent}"
                                                CornerRadius="2"
                                                Visibility="Collapsed"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource App.Hover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource App.Hover}"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource App.Hover}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"/>
                            <Button Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Margin="8,0,0,0"
                                    Width="18" Height="18">
                                <TextBlock Text="✕" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           />
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Opacity" Value="0.45"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanClose}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Setter Property="Background" Value="{DynamicResource App.Hover}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
            </Border>
        </ui:NavigationView>
    </DockPanel>
</Window>
